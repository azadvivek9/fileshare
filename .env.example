# Frontend Configuration
# Optional: Set this only if your signaling server is hosted on a separate domain.
# If omitted or empty, the frontend will automatically connect to wss://<current-host>/ws in production.
# Example: VITE_SIGNALING_URL=wss://your-signaling-domain.com/ws
VITE_SIGNALING_URL=

# Optional: Custom STUN/TURN servers JSON array (defaults to Google STUN if unset)
# Example: VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
VITE_ICE_SERVERS=

# Backend Signaling Server Configuration
# Port for the Node.js signaling & static server (defaults to 3000 if unset)
PORT=3000
